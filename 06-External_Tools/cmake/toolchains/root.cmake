cmake_minimum_required(VERSION 3.0.0)

get_filename_component(PROJECT_DIR ${CMAKE_CURRENT_BINARY_DIR} DIRECTORY)
get_filename_component(PROJECT_FOLDER ${PROJECT_DIR} NAME)

set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${PROJECT_DIR}/Make_Exe/04-Exe)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${PROJECT_DIR}/Make_Exe/04-Exe)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${PROJECT_DIR}/Make_Exe/04-Exe)
set(CMAKE_OBJECTS_OUTPUT_DIRECTORY ${PROJECT_DIR}/Make_Exe/03-Obj)
set(CMAKE_LST_OUTPUT_DIRECTORY ${PROJECT_DIR}/Make_Exe/02-Lst)
set(CMAKE_DEP_OUTPUT_DIRECTORY ${PROJECT_DIR}/Make_Exe/01-dep)

## create dep and lst directories
file(MAKE_DIRECTORY ${CMAKE_LST_OUTPUT_DIRECTORY})
file(MAKE_DIRECTORY ${CMAKE_DEP_OUTPUT_DIRECTORY})

set(CMAKE_SYSTEM_NAME               Generic)
set(CMAKE_SYSTEM_PROCESSOR          ${MICROCONTROLLER})
set(CMAKE_TRY_COMPILE_TARGET_TYPE  "STATIC_LIBRARY")

if(${COMPILER_TYPE} STREQUAL "GHS")
    include("${CMAKE_CURRENT_LIST_DIR}/ghs.cmake")
elseif(${COMPILER_TYPE} STREQUAL "IAR")
    if(${ARCHITECTURE} STREQUAL "NXP")
        include("${CMAKE_CURRENT_LIST_DIR}/iar_nxp.cmake")
    elseif(${ARCHITECTURE} STREQUAL "ARMM3")
        include("${CMAKE_CURRENT_LIST_DIR}/iar_arm.cmake")
    elseif(${ARCHITECTURE} STREQUAL "VWSRL78")
        include("${CMAKE_CURRENT_LIST_DIR}/iar_vwsrl78.cmake")
    elseif(${ARCHITECTURE} STREQUAL "RL78")
        include("${CMAKE_CURRENT_LIST_DIR}/iar_rl78.cmake")
    elseif(${ARCHITECTURE} STREQUAL "MSP430")
        include("${CMAKE_CURRENT_LIST_DIR}/iar_msp430.cmake")        
    endif()
elseif(${COMPILER_TYPE} STREQUAL "HIGHTEC")
    include("${CMAKE_CURRENT_LIST_DIR}/hightec.cmake")
elseif(${COMPILER_TYPE} STREQUAL "CLANG")
    include("${CMAKE_CURRENT_LIST_DIR}/CLANG.cmake")
endif()

set(ALL_FILES_EXTENSIONS ${SOURCE_FILE_EXTENSIONS} ${INCLUDE_FILES_EXTENSIONS})

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)